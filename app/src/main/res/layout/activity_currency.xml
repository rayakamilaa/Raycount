<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Judul Halaman -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="serif"
        android:text="Konversi Mata Uang"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Card Input Timbul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_display_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nominal dalam Rupiah (IDR)"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etIdrAmount"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            android:hint="Contoh: 150.000"
            android:inputType="number"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Pilih Mata Uang Tujuan"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerCurrency"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_display_card"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Tombol Hitung Timbul -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConvert"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/btn_magenta"
        android:text="Konversi Sekarang"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:elevation="8dp" />

    <!-- Hasil Konversi -->
    <TextView
        android:id="@+id/tvCurrencyResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="Hasil: -"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

</LinearLayout>